# Copiez ce fichier en .env.local (dans front/) puis adaptez si besoin.
# .env.local n'est jamais commité (cf. front/.gitignore) — ce fichier
# .env.example, lui, l'est.

# URL de base de l'API Symfony. Doit correspondre au serveur backend lancé
# en local (symfony server:start ou php -S 127.0.0.1:8000 -t public).
# Vérifiez aussi que CORS_ALLOW_ORIGIN côté back autorise bien cette origine.
VITE_API_URL=http://localhost:8000
APP_NAME=Saveurs