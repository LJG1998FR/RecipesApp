# Copiez ce fichier en .env.local puis complétez les valeurs.
# .env.local n'est JAMAIS commité (cf. .gitignore) — ce fichier .env.example,
# lui, l'est : il ne doit donc contenir aucune vraie valeur sensible.

###> symfony/framework-bundle ###
APP_ENV=dev
# Chaîne aléatoire propre à chaque installation, ex: `openssl rand -hex 16`
APP_SECRET=ChangeMe
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Format : DATABASE_URL="mysql://utilisateur:motdepasse@127.0.0.1:3306/nom_bdd?serverVersion=8.0&charset=utf8mb4"
# (remplacez mysql par postgresql si vous utilisez PostgreSQL)
DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/saveurs?serverVersion=8.0&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# File d'attente utilisée pour l'envoi asynchrone des emails.
# ⚠️ Un worker doit tourner pour que les emails partent réellement :
#   php bin/console messenger:consume async -vv
MESSENGER_TRANSPORT_DSN=doctrine://default?queue_name=async
###< symfony/messenger ###

###> lexik/jwt-authentication-bundle ###
# Clés générées avec : php bin/console lexik:jwt:generate-keypair
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
# Passphrase choisie au moment de la génération des clés ci-dessus
JWT_PASSPHRASE=ChangeMe
# Durée de vie du token JWT, en secondes (3600 = 1h)
JWT_TTL=3600
###< lexik/jwt-authentication-bundle ###

###> gesdinet/jwt-refresh-token-bundle ###
# Durée de vie du refresh token, en secondes (2592000 = 30 jours)
# Le refresh token est à usage unique : chaque rafraîchissement en émet un nouveau.
REFRESH_TOKEN_TTL=2592000
###< gesdinet/jwt-refresh-token-bundle ###

###> nelmio/cors-bundle ###
# Doit correspondre à l'URL exacte du front (voir front/.env.example -> VITE_API_URL,
# c'est la relation inverse : ici c'est le FRONT qu'on autorise à appeler l'API).
CORS_ALLOW_ORIGIN=^http://localhost:5173$
###< nelmio/cors-bundle ###

###> symfony/mailer ###
# En local, pointez de préférence vers un attrape-emails (Mailpit, Mailtrap...)
# plutôt qu'un vrai SMTP, pour ne jamais envoyer d'email réel par erreur.
# Exemple avec Mailpit tournant en local : smtp://localhost:1025
MAILER_DSN=smtp://localhost:1025
# Adresse et nom "expéditeur" affichés sur tous les emails envoyés par l'app
MAILER_FROM_ADDRESS=no-reply@saveurs.app
MAILER_FROM_NAME="Saveurs"
###< symfony/mailer ###

###> app (custom) ###
# URL publique de l'API, utilisée pour générer des URLs absolues en contexte
# non-HTTP (commandes CLI, workers Messenger...).
DEFAULT_URI=http://localhost:8000

# URL publique du FRONT (pas du back !) — utilisée pour construire le lien
# envoyé dans l'email de réinitialisation de mot de passe, de la forme :
# {FRONTEND_URL}/reinitialiser-mot-de-passe?token=...
FRONTEND_URL=http://localhost:5173
###< app (custom) ###
