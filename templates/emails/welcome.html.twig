{# templates/emails/welcome.html.twig #}
<!DOCTYPE html>
<html lang="{{ locale }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
    </head>
    <body style="margin:0; font-family: Arial, sans-serif; background:#171210; color:#f0e8e0;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
            <tr>
                <td align="center" style="padding: 40px 20px;">
                    <table role="presentation" width="100%" style="max-width: 480px;" cellpadding="0" cellspacing="0">
                        <tr>
                            <td style="padding-bottom: 24px;">
                                <h1 style="font-size: 24px; margin: 0;">
                                    {{ 'welcome.heading'|trans({'{firstName}': user.firstName}, 'emails', locale) }}
                                </h1>
                            </td>
                        </tr>
                        <tr>
                            <td style="padding-bottom: 32px; font-size: 15px; line-height: 1.6;">
                                {{ 'welcome.body'|trans({}, 'emails', locale) }}
                            </td>
                        </tr>
                        <tr>
                            <td style="padding-bottom: 32px;">
                                <a href="https://votre-domaine.fr"
                                style="background:#e09a5a; color:#171210; padding:12px 24px; border-radius:12px; text-decoration:none; font-weight:bold; display:inline-block;">
                                    {{ 'welcome.cta_button'|trans({}, 'emails', locale) }}
                                </a>
                            </td>
                        </tr>
                        <tr>
                            <td style="font-size: 12px; color: #a89880; border-top: 1px solid #2e2924; padding-top: 16px;">
                                {{ 'welcome.footer'|trans({}, 'emails', locale) }}
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>
    </body>
</html>