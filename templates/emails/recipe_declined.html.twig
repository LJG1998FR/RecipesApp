<html lang="{{ locale }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
    </head>
    <body style="margin:0; font-family: Arial, sans-serif; background:#171210; color:#f0e8e0;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
            <tr>
                <td align="center" style="padding: 40px 20px;">
                    <table role="presentation" width="100%" style="max-width: 480px;" cellpadding="0" cellspacing="0">
                        <tr>
                            <td style="padding-bottom: 24px;">
                                <h1 style="font-size: 24px; margin: 0; color:#e07070;">
                                    {{ 'recipe_declined.heading'|trans({}, 'emails', locale) }}
                                </h1>
                            </td>
                        </tr>
                        <tr>
                            <td style="padding-bottom: 20px; font-size: 15px; line-height: 1.6;">
                                {{ 'recipe_declined.body'|trans({'{title}': recipe.title}, 'emails', locale) }}
                            </td>
                        </tr>
                        <tr>
                            <td style="padding-bottom: 32px;">
                                <table role="presentation" cellpadding="0" cellspacing="0" width="100%"
                                    style="background:#221e1b; border:1px solid #2e2924; border-radius:12px; padding:14px 18px;">
                                    <tr>
                                        <td style="font-size: 12px; color:#a89880; padding-bottom:6px;">
                                            {{ 'recipe_declined.reason_label'|trans({}, 'emails', locale) }}
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="font-size: 14px; color:#f0e8e0; line-height:1.5;">
                                            {# ⚠️ 'reason' n'est PAS traduit : c'est un texte libre saisi par un
                                            modérateur, pas une clé de traduction. On l'affiche tel quel. #}
                                            {{ reason|default('recipe_declined.reason_fallback'|trans({}, 'emails', locale)) }}
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                        <tr>
                            <td style="font-size: 12px; color: #a89880; border-top: 1px solid #2e2924; padding-top: 16px;">
                                {{ 'recipe_declined.footer'|trans({}, 'emails', locale) }}
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>
    </body>
</html>