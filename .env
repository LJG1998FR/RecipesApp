APP_ENV=prod
APP_SECRET=ChangeThisDefaultSecret
DATABASE_URL="postgresql://user:pass@127.0.0.1:5432/app?serverVersion=16&charset=utf8"
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###> app (custom) ###
# URL publique de l'API, utilisée pour générer des URLs absolues en contexte
# non-HTTP (commandes CLI, workers Messenger...).
DEFAULT_URI=http://localhost:8000

# URL publique du FRONT (pas du back !) — utilisée pour construire le lien
# envoyé dans l'email de réinitialisation de mot de passe, de la forme :
# {FRONTEND_URL}/reinitialiser-mot-de-passe?token=...
FRONTEND_URL=http://localhost:5173
###< app (custom) ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
MAILER_DSN=null://null
MAILER_FROM_ADDRESS=no-reply@saveurs.app
MAILER_FROM_NAME=Saveurs
###< symfony/mailer ###